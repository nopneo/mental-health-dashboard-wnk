# คัดลอกเป็น .env แล้ว chown root:mh + chmod 640 (ห้ามส่งไฟล์ .env ให้ใคร)
# ---- ฐานข้อมูล HOSxP: บัญชีที่ "อ่านอย่างเดียว" (SELECT) แนะนำให้ชี้ไปที่เครื่องสำรอง (replica)
DB_HOST=192.168.0.10
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>

# ---- เว็บ
PORT=6300
# สร้างด้วย: python3 -c "import secrets; print(secrets.token_hex(32))"
MH_SECRET_KEY=<random>
# 1 เมื่อเปิดผ่าน https (cookie ส่งเฉพาะ https) · ทดสอบผ่าน http บน LAN ให้ตั้ง 0
MH_COOKIE_SECURE=1
# ที่เก็บ SQLite (บัญชีผู้ใช้ + ผลประเมิน) — ผู้ใช้ของ service ต้องเขียนได้
MH_DATA_DIR=/opt/mental_health/data

# ---- ข้อมูลโรงพยาบาล (ไม่ใส่ชื่อ = ใช้ opdconfig.hospitalname ของ HOSxP)
MH_HOSPITAL_NAME=โรงพยาบาลตัวอย่าง
MH_HOSPITAL_NAME_EN=EXAMPLE HOSPITAL
MH_CONTACT=งานสุขภาพจิต โรงพยาบาลตัวอย่าง โทร 0-0000-0000
# รหัสหน่วยบริการ 5 หลักของ รพ. (หมู่บ้านที่ รพ. ดูแลเองใน village_pcu.csv ใช้รหัสนี้)
MH_HOSPCODE=10894
# จังหวัด/อำเภอของ รพ. ตามรหัสใน patient.chwpart / amppart (ผู้ป่วยนอกอำเภอ = "นอกเขต")
MH_CHWPART=30
MH_AMPPART=25
# คลินิกจิตเวชใน oapp.clinic (นับขาดนัด) — หลายรหัสคั่นด้วย ,
MH_CLINIC=025
# ยาฉีดออกฤทธิ์นาน (LAI) จาก drugitems.icode — "icode=ชื่อ;icode=ชื่อ"
MH_LAI_ICODES=1000310=Fluphenazine decanoate;1000352=Haloperidol decanoate
# รพ.จิตเวชที่ส่งต่อประจำ (referout.refer_hospcode) — หลายรหัสคั่นด้วย ,
MH_PSY_HOSPCODES=12268
# ตารางหมู่บ้าน → รพ.สต. (ไม่ใส่ = village_pcu.csv ในโฟลเดอร์แอป)
# MH_VILLAGE_CSV=/opt/mental_health/village_pcu.csv
# MH_CACHE_TTL=300
# MH_FY_FROM=2561
